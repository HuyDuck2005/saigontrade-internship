<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view của Wizard -->
    <record id="view_create_deal_wizard_form" model="ir.ui.view">
        <field name="name">create.deal.wizard.form</field>
        <field name="model">create.deal.wizard</field>
        <field name="arch" type="xml">
            <form string="Tạo Deal Hàng Loạt">
                <group>
                    <field name="deal_name"/>
                    <field name="expected_revenue"/>
                    <field name="event"/>
                    <field name="event_location"/>
                    <field name="notes"/>
                </group>
                <footer>
                    <button name="action_create_deals" type="object" string="Tạo Deal" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Nút Action gắn vào model res.partner (Khách hàng) -->
    <record id="action_create_deal_wizard" model="ir.actions.act_window">
        <field name="name">Tạo Deal hàng loạt</field>
        <field name="res_model">create.deal.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_create_deal_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
