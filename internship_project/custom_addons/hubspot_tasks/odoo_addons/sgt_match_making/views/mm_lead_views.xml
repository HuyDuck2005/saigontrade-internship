<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_mm_lead" model="ir.sequence">
        <field name="name">Match Making Sequence</field>
        <field name="code">mm.lead.seq</field>
        <field name="prefix">MM-</field>
        <field name="padding">3</field>
    </record>

    <!-- Form View chuẩn để hiển thị đầy đủ các trường -->
    <record id="view_mm_lead_form" model="ir.ui.view">
        <field name="name">mm.lead.form</field>
        <field name="model">mm.lead</field>
        <field name="arch" type="xml">
            <form string="Match Making">
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Company A (Nhu cầu)">
                            <field name="partner_id"/>
                            <field name="email_1"/>
                            <field name="phone_1"/>
                        </group>
                        <group string="Company B (Cung cấp)">
                            <field name="partner_id_2"/>
                            <field name="email_2"/>
                            <field name="phone_2"/>
                        </group>
                    </group>
                    <group>
                        <field name="user_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_mm_lead_kanban" model="ir.ui.view">
        <field name="name">mm.lead.kanban</field>
        <field name="model">mm.lead</field>
        <field name="arch" type="xml">
            <kanban default_class="o_kanban_small_column" default_group_by="stage_id">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="partner_id_2"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                            <div class="text-muted"><i class="fa fa-building" title="Company A"/> <field name="partner_id"/></div>
                            <div class="text-muted"><i class="fa fa-handshake-o" title="Company B"/> <field name="partner_id_2"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List View -->
    <record id="view_mm_lead_list" model="ir.ui.view">
        <field name="name">mm.lead.list</field>
        <field name="model">mm.lead</field>
        <field name="arch" type="xml">
            <list string="Match Making">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="partner_id_2"/>
                <field name="user_id"/>
                <field name="stage_id" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_mm_lead" model="ir.actions.act_window">
        <field name="name">B2B Match Making</field>
        <field name="res_model">mm.lead</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_mm_root" name="Match Making" sequence="20"/>
    <menuitem id="menu_mm_lead" name="Matches Pipeline" parent="menu_mm_root" action="action_mm_lead" sequence="10"/>
</odoo>
