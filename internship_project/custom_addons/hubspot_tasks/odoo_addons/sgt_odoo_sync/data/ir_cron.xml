<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_retry_sync_logs" model="ir.cron">
            <field name="name">Auto Retry Failed Sync Logs</field>
            <field name="model_id" ref="model_sync_log"/>
            <field name="state">code</field>
            <field name="code">model.cron_retry_failed_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
        
        <record id="seq_sync_log" model="ir.sequence">
            <field name="name">Sync Log Sequence</field>
            <field name="code">sync.log</field>
            <field name="prefix">SYNC-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
