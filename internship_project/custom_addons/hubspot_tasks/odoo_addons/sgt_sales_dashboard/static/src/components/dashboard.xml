<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sgt_sales_dashboard.Dashboard" owl="1">
        <div class="o_action_manager bg-200 w-100 h-100 overflow-auto p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold text-dark mb-0">Tổng quan Phân tích CRM</h2>
            </div>
            <t t-if="state.isLoading">
                <div class="text-center py-5 text-muted">
                    <i class="fa fa-circle-o-notch fa-spin fa-3x mb-3"/>
                    <h4>Đang tải dữ liệu...</h4>
                </div>
            </t>
            <t t-else="">
                <div class="row g-3 mb-4">
                    <div class="col-md-3"><div class="card shadow-sm border-0 h-100"><div class="card-body">
                        <h6 class="text-muted fw-bold mb-2">Tổng số cơ hội</h6>
                        <h3 class="fw-bold text-dark mb-0"><t t-esc="state.data.kpi.total_opportunities"/></h3>
                    </div></div></div>
                    <div class="col-md-3"><div class="card shadow-sm border-0 h-100"><div class="card-body">
                        <h6 class="text-muted fw-bold mb-2">Doanh thu dự kiến</h6>
                        <h3 class="fw-bold text-primary mb-0"><t t-esc="formatCurrency(state.data.kpi.expected_revenue)"/></h3>
                    </div></div></div>
                    <div class="col-md-3"><div class="card shadow-sm border-0 h-100"><div class="card-body">
                        <h6 class="text-muted fw-bold mb-2">Cơ hội thắng</h6>
                        <h3 class="fw-bold text-success mb-0"><t t-esc="state.data.kpi.won_deals"/></h3>
                    </div></div></div>
                    <div class="col-md-3"><div class="card shadow-sm border-0 h-100"><div class="card-body">
                        <h6 class="text-muted fw-bold mb-2">Tỷ lệ chuyển đổi</h6>
                        <h3 class="fw-bold text-warning mb-0"><t t-esc="state.data.kpi.conversion_rate"/>%</h3>
                    </div></div></div>
                </div>
                <div class="row g-3 mb-4">
                    <div class="col-md-8"><div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white border-bottom-0 pt-3"><h5 class="fw-bold text-dark mb-0">Doanh thu theo Giai đoạn</h5></div>
                        <div class="card-body"><canvas t-ref="barChart" style="max-height: 300px;"/></div>
                    </div></div>
                    <div class="col-md-4"><div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white border-bottom-0 pt-3"><h5 class="fw-bold text-dark mb-0">Nguồn khách hàng</h5></div>
                        <div class="card-body d-flex justify-content-center"><canvas t-ref="pieChart" style="max-height: 300px;"/></div>
                    </div></div>
                </div>
            </t>
        </div>
    </t>
</templates>
