<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sgt_sales_dashboard.Dashboard" owl="1">
        <div class="bg-200 w-100 h-100 overflow-auto p-4">
            
            <!-- HEADER & BỘ LỌC THỜI GIAN MỞ RỘNG -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-dark fw-bold mb-0">
                    <i class="fa fa-pie-chart text-primary me-2"/> Trung Tâm Phân Tích Kinh Doanh
                </h2>
                <div class="d-flex gap-3 align-items-center">
                    <label class="fw-bold text-muted mb-0">Mốc thời gian:</label>
                    <select class="form-select shadow-sm border-0" t-on-change="onChangeFilter" t-model="state.filter" style="width: 220px;">
                        <option value="all">Toàn bộ thời gian</option>
                        <option value="today">Hôm nay</option>
                        <option value="this_week">Tuần này</option>
                        <option value="this_month" selected="1">Tháng này</option>
                        <option value="this_quarter">Quý này</option>
                        <option value="this_year">Năm nay</option>
                    </select>
                </div>
            </div>

            <!-- 4 THẺ SỐ LIỆU (KPI CARDS) -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
                        <div class="card-body">
                            <h6 class="text-muted fw-bold mb-2">Tổng Cơ Hội (Deals)</h6>
                            <h2 class="fw-bold text-dark mb-0" t-esc="state.kpi.total_deals"/>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
                        <div class="card-body">
                            <h6 class="text-muted fw-bold mb-2">Doanh Thu Dự Kiến</h6>
                            <h2 class="fw-bold text-success mb-0" t-esc="state.kpi.total_revenue"/>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0 border-start border-warning border-4 h-100">
                        <div class="card-body">
                            <h6 class="text-muted fw-bold mb-2">Cơ Hội Đã Thắng</h6>
                            <h2 class="fw-bold text-warning mb-0" t-esc="state.kpi.won_deals"/>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card shadow-sm border-0 border-start border-danger border-4 h-100">
                        <div class="card-body">
                            <h6 class="text-muted fw-bold mb-2">Tỷ Lệ Thắng (Win Rate)</h6>
                            <h2 class="fw-bold text-danger mb-0" t-esc="state.kpi.win_rate"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2 KHUNG BIỂU ĐỒ CÓ NÚT CHUYỂN ĐỔI KIỂU HIỂN THỊ -->
            <div class="row g-3 mb-4">
                <!-- Cột trái: Phễu doanh thu kèm nút đổi dạng Cột / Đường -->
                <div class="col-md-8">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white border-bottom-0 d-flex justify-content-between align-items-center pt-4 pb-0">
                            <h5 class="fw-bold text-dark mb-0"><i class="fa fa-bar-chart text-info me-2"/> Phễu Doanh Thu</h5>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary" t-att-class="state.barType === 'bar' ? 'active' : ''" t-on-click="() => this.changeBarType('bar')"><i class="fa fa-bar-chart"/> Cột</button>
                                <button class="btn btn-outline-primary" t-att-class="state.barType === 'line' ? 'active' : ''" t-on-click="() => this.changeBarType('line')"><i class="fa fa-line-chart"/> Đường</button>
                            </div>
                        </div>
                        <div class="card-body">
                            <div style="position: relative; height: 300px;">
                                <canvas t-ref="barChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Cột phải: Nguồn khách hàng kèm nút đổi dạng Tròn / Vòng Khuyết -->
                <div class="col-md-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white border-bottom-0 d-flex justify-content-between align-items-center pt-4 pb-0">
                            <h5 class="fw-bold text-dark mb-0"><i class="fa fa-pie-chart text-warning me-2"/> Nguồn</h5>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-warning" t-att-class="state.pieType === 'doughnut' ? 'active' : ''" t-on-click="() => this.changePieType('doughnut')"><i class="fa fa-circle-o"/> Tròn</button>
                                <button class="btn btn-outline-warning" t-att-class="state.pieType === 'pie' ? 'active' : ''" t-on-click="() => this.changePieType('pie')"><i class="fa fa-pie-chart"/> Quạt</button>
                            </div>
                        </div>
                        <div class="card-body d-flex justify-content-center align-items-center">
                            <div style="position: relative; height: 250px; width: 100%;">
                                <canvas t-ref="pieChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </t>
</templates>
