<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. CÁC VIEW BIỂU ĐỒ -->
    <record id="view_graph_bar_stage" model="ir.ui.view">
        <field name="name">crm.lead.graph.bar</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <graph string="Phễu Doanh thu" type="bar" stacked="True" sample="1">
                <field name="stage_id"/>
                <field name="expected_revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_graph_pie_source" model="ir.ui.view">
        <field name="name">crm.lead.graph.pie</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <graph string="Nguồn Khách hàng" type="pie" sample="1">
                <field name="source_id"/>
                <field name="expected_revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_graph_line_revenue" model="ir.ui.view">
        <field name="name">crm.lead.graph.line</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <graph string="Xu hướng Doanh thu" type="line" sample="1">
                <field name="create_date" interval="month"/>
                <field name="expected_revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_pivot_overview" model="ir.ui.view">
        <field name="name">crm.lead.pivot</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <pivot string="Ma trận Doanh thu" sample="1">
                <field name="create_date" interval="month" type="row"/>
                <field name="stage_id" type="col"/>
                <field name="expected_revenue" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- 2. CÁC ACTION MỞ TỪNG BIỂU ĐỒ -->
    <record id="action_graph_bar" model="ir.actions.act_window">
        <field name="name">Phễu Doanh thu</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_graph_bar_stage"/>
        <field name="domain">[('type', '=', 'opportunity')]</field>
    </record>

    <record id="action_graph_pie" model="ir.actions.act_window">
        <field name="name">Nguồn Khách hàng</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_graph_pie_source"/>
        <field name="domain">[('type', '=', 'opportunity')]</field>
    </record>

    <record id="action_graph_line" model="ir.actions.act_window">
        <field name="name">Xu hướng Doanh thu theo tháng</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_graph_line_revenue"/>
        <field name="domain">[('type', '=', 'opportunity')]</field>
    </record>

    <record id="action_pivot_table" model="ir.actions.act_window">
        <field name="name">Ma trận Phân tích</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_pivot_overview"/>
        <field name="domain">[('type', '=', 'opportunity')]</field>
    </record>

    <!-- 3. DASHBOARD LẮP RÁP (FIX LỖI ID) -->
    <record id="board_sales_dashboard_form" model="ir.ui.view">
        <field name="name">board.sales.dashboard.form</field>
        <field name="model">board.board</field>
        <field name="arch" type="xml">
            <form string="Trung tâm Phân tích BI">
                <board style="1-2">
                    <column>
                        <!-- Gọi tên định danh tuyệt đối thay vì gọi cục bộ -->
                        <action name="%(sgt_sales_dashboard.action_graph_line)d" string="📈 Xu hướng Doanh thu (Đường)"/>
                        <action name="%(sgt_sales_dashboard.action_pivot_table)d" string="🧮 Ma trận Dữ liệu (Kéo thả)"/>
                    </column>
                    <column>
                        <action name="%(sgt_sales_dashboard.action_graph_bar)d" string="📊 Phễu Doanh thu (Cột)"/>
                        <action name="%(sgt_sales_dashboard.action_graph_pie)d" string="🥧 Tỷ trọng Nguồn (Tròn)"/>
                    </column>
                </board>
            </form>
        </field>
    </record>

    <record id="open_board_sales_dashboard" model="ir.actions.act_window">
        <field name="name">BI Analytics</field>
        <field name="res_model">board.board</field>
        <field name="view_mode">form</field>
        <field name="usage">menu</field>
        <field name="view_id" ref="board_sales_dashboard_form"/>
    </record>

    <!-- 4. MENU -->
    <menuitem id="menu_sgt_bi_dashboard"
              name="📊 BI Analytics"
              parent="crm.crm_menu_root"
              action="open_board_sales_dashboard"
              sequence="1"/>
</odoo>
