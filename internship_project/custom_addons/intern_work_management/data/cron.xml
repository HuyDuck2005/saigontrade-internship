<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_remind_daily_report" model="ir.cron">
            <field name="name">Nhắc nhở TTS nộp Báo cáo ngày (17:00)</field>
            <field name="model_id" ref="model_daily_report"/>
            <field name="state">code</field>
            <field name="code">model.cron_remind_daily_report()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
            <field name="nextcall" eval="(DateTime.now().replace(hour=10, minute=0, second=0)).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>
    </data>
</odoo>
