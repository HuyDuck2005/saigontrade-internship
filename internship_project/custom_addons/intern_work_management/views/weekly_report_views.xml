<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_weekly_report_tree" model="ir.ui.view">
        <field name="name">weekly.report.tree</field>
        <field name="model">weekly.report</field>
        <field name="arch" type="xml">
            <tree string="Weekly Reports">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="start_date"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'reviewed'"/>
            </tree>
        </field>
    </record>

    <record id="view_weekly_report_form" model="ir.ui.view">
        <field name="name">weekly.report.form</field>
        <field name="model">weekly.report</field>
        <field name="arch" type="xml">
            <form string="Weekly Report">
                <header>
                    <button name="action_submit" string="Nộp Báo Cáo" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_review" string="Lưu &amp; Chốt Điểm" type="object" class="oe_highlight" invisible="state != 'submitted'" groups="base.group_erp_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,reviewed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="state != 'draft'"/></h1>
                    </div>
                    <group>
                        <group><field name="employee_id" readonly="state != 'draft'"/></group>
                        <group>
                            <field name="start_date" readonly="state != 'draft'"/>
                            <field name="end_date" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tổng Hợp Công Việc">
                            <group>
                                <field name="completed_task_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                                <field name="in_progress_task_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                            </group>
                        </page>
                        <page string="Vấn Đề &amp; Kế Hoạch">
                            <group>
                                <field name="issues_summary" readonly="state != 'draft'"/>
                                <field name="next_week_plan" readonly="state != 'draft'"/>
                            </group>
                        </page>
                        <page string="Đánh Giá Của Admin" invisible="state == 'draft'">
                            <group>
                                <field name="manager_score" widget="priority" readonly="state == 'reviewed'"/>
                                <field name="manager_feedback" placeholder="Admin nhập nhận xét tại đây..." readonly="state == 'reviewed'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_weekly_report" model="ir.actions.act_window">
        <field name="name">Báo Cáo Tuần</field>
        <field name="res_model">weekly.report</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
