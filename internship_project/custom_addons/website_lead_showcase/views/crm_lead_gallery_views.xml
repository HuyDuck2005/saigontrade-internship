<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_gallery_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.gallery.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Ảnh sản phẩm &amp; Nhà sản xuất" name="product_images">
                    <field name="gallery_image_ids" mode="list">
                        <list editable="bottom">
                            <field name="image" widget="image" options="{'size': [90, 60]}" string="Hình ảnh"/>
                            <field name="name" string="Tên sản phẩm / Miêu tả ảnh"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
