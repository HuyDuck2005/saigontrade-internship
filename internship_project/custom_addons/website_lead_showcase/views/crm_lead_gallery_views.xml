<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_gallery_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.gallery.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Ảnh sản phẩm &amp; Nhà sản xuất" name="product_images">
                    <field name="gallery_image_ids" mode="kanban" widget="many2many_kanban">
                        <kanban>
                            <field name="id"/>
                            <field name="name"/>
                            <field name="image"/>
                            <templates>
                                <t t-name="kanban-box">
                                    <div class="oe_kanban_global_click card m-1 p-2" style="width: 150px; display: inline-block; vertical-align: top;">
                                        <div class="o_kanban_image text-center mb-1" style="height: 100px; overflow: hidden;">
                                            <img t-attf-src="/web/image/lead.gallery.image/#{record.id.raw_value}/image" class="w-100 h-100" style="object-fit: cover; border-radius: 4px;" alt="Ảnh"/>
                                        </div>
                                        <div class="oe_kanban_details text-center">
                                            <strong class="o_kanban_record_title text-truncate d-block" style="font-size: 12px;"><field name="name"/></strong>
                                            <a t-if="widget.deletable" type="delete" class="text-danger small mt-1 d-inline-block"><i class="fa fa-trash"/> Xóa ảnh này</a>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                        <form string="Chi tiết ảnh sản phẩm">
                            <sheet>
                                <group>
                                    <field name="name"/>
                                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
