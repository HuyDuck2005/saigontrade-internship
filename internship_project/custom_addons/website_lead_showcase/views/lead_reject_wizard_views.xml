<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lead_reject_wizard_form" model="ir.ui.view">
        <field name="name">lead.reject.wizard.form</field>
        <field name="model">lead.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Từ chối Lead">
                <group>
                    <field name="lead_id" invisible="1"/>
                    <field name="rejection_reason" placeholder="Vui lòng nhập lý do từ chối..."/>
                </group>
                <footer>
                    <button string="Xác nhận Từ chối" name="action_confirm_reject" type="object" class="btn-danger"/>
                    <button string="Hủy bỏ" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
