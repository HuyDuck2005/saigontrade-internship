<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_lead_gallery_template_inherit" inherit_id="website_lead_showcase.lead_detail">
        <xpath expr="//div[hasclass('lead-full-description')]/.." position="after">
            <t t-if="lead.gallery_image_ids">
                <div class="mt-5 mb-5 pt-4 border-top">
                    <h3 class="mb-4"><i class="fa fa-picture-o text-primary"></i> Hình ảnh &amp; Thông tin chi tiết</h3>
                    <div class="row g-5">
                        <t t-foreach="lead.gallery_image_ids" t-as="img">
                            <div class="col-12">
                                <div class="card shadow-sm border-0 h-100 bg-light rounded-3 overflow-hidden">
                                    <div class="p-3 text-center" style="background: white;">
                                        <img t-attf-src="/web/image/lead.gallery.image/#{img.id}/image" 
                                             class="img-fluid rounded" 
                                             style="max-height: 500px; width: auto; object-fit: contain;" 
                                             alt="Ảnh sản phẩm"/>
                                    </div>
                                    <div class="card-footer bg-light border-0 p-4">
                                        <t t-if="img.name and img.name != 'Ảnh sản phẩm'">
                                            <h5 class="mb-0 text-dark" style="line-height: 1.5;"><t t-esc="img.name"/></h5>
                                        </t>
                                        <t t-else="">
                                            <p class="mb-0 text-muted font-italic"><t t-esc="img.name"/></p>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>