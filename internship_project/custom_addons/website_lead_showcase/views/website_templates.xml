                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Phân loại nhu cầu *</label>
                                    <select name="intent" class="form-select">
                                        <option value="sell">CHÀO BÁN / CUNG CẤP NGUỒN HÀNG</option>
                                        <option value="buy">TÌM MUA / THU MUA SỐ LƯỢNG LỚN</option>
                                        <option value="partner">TÌM ĐỐI TÁC GIA CÔNG / LIÊN DANH</option>
