<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <!-- Groups -->
    <record id="group_lead_approver" model="res.groups">
        <field name="name">Lead Approvers</field>
        <field name="comment">Can approve/reject leads for website publication</field>
    </record>
    
    <record id="group_lead_manager" model="res.groups">
        <field name="name">Lead Managers</field>
        <field name="comment">Can manage all lead operations</field>
        <field name="implied_ids" eval="[(4, ref('group_lead_approver'))]"/>
    </record>
    
    <!-- Access Rules -->
    <record id="access_lead_category_user" model="ir.model.access">
        <field name="name">Lead Category User</field>
        <field name="model_id" ref="model_lead_category"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>
    
    <record id="access_lead_approval_history_user" model="ir.model.access">
        <field name="name">Lead Approval History User</field>
        <field name="model_id" ref="model_lead_approval_history"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>
    
    <!-- Approver Rules -->
    <record id="access_crm_lead_approver" model="ir.model.access">
        <field name="name">CRM Lead Approver</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="group_id" ref="group_lead_approver"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>
    
    <record id="access_lead_reject_wizard" model="ir.model.access">
        <field name="name">Lead Reject Wizard Access</field>
        <field name="model_id" ref="model_lead_reject_wizard"/>
        <field name="group_id" ref="group_lead_approver"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>

</odoo>
