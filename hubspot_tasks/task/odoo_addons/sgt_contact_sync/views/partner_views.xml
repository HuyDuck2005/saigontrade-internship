<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_sync" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.sync</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="before">
                <header>
                    <button name="action_sync_to_odoo2" string="🔄 Đồng bộ sang Odoo 2" type="object" class="oe_highlight"/>
                    <field name="sync_status_odoo2" widget="badge" decoration-success="sync_status_odoo2 == 'synced'" decoration-danger="sync_status_odoo2 == 'failed'" decoration-warning="sync_status_odoo2 == 'draft'"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
