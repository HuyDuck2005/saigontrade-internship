<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_inherit_sync" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.sync</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <!-- Nút Task 6 -->
                <button name="action_create_contact_both"
                        string="Tạo Contact Odoo1 &amp; Odoo2"
                        type="object"
                        class="btn-primary"/>
                <!-- Nút Task 10 -->
                <button name="action_retry_sync_deal"
                        string="Retry Sync Odoo2"
                        type="object"
                        class="btn-warning"
                        invisible="sync_status == 'success'"/>
            </xpath>
            <xpath expr="//page[@name='lead']" position="after">
                <page string="Trạng thái Sync Odoo 2" name="sync_odoo2">
                    <group>
                        <group>
                            <field name="sync_status" widget="badge"
                                   decoration-success="sync_status == 'success'"
                                   decoration-danger="sync_status == 'failed'"/>
                            <field name="remote_partner_id"/>
                            <field name="remote_lead_id"/>
                            <field name="retry_count"/>
                        </group>
                        <group>
                            <field name="sync_error_msg"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
