<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sgt_crm_lead_comparative_pivot" model="ir.ui.view">
        <field name="name">crm.lead.comparative.pivot</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <pivot string="Bảng So sánh Doanh thu (Comparative Analysis)" sample="1">
                <field name="create_date" interval="quarter" type="col"/>
                <field name="stage_id" type="row"/>
                <field name="expected_revenue" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_sgt_crm_lead_search_bi" model="ir.ui.view">
        <field name="name">crm.lead.search.bi</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <group expand="0" string="Nhóm theo Kỳ (Slicers)">
                    <filter string="Theo Năm" name="groupby_year" context="{'group_by':'create_date:year'}"/>
                    <filter string="Theo Quý" name="groupby_quarter" context="{'group_by':'create_date:quarter'}"/>
                    <filter string="Theo Tháng" name="groupby_month" context="{'group_by':'create_date:month'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_sgt_bi_dashboard_reports" model="ir.actions.act_window">
        <field name="name">Báo cáo Ma trận (Pivot)</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">pivot,tree,graph</field>
        <field name="search_view_id" ref="view_sgt_crm_lead_search_bi"/>
        <field name="domain">[('type', '=', 'opportunity')]</field>
        <field name="context">{'search_default_groupby_year': 1}</field>
    </record>

    <menuitem id="menu_sgt_crm_reports" name="Báo cáo Ma trận" parent="menu_sgt_crm_analytics" action="action_sgt_bi_dashboard_reports" sequence="2"/>
</odoo>
