<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_work_feedback_tree" model="ir.ui.view">
        <field name="name">work.feedback.tree</field>
        <field name="model">work.feedback</field>
        <field name="arch" type="xml">
            <tree string="Feedback">
                <field name="presentation_id"/>
                <field name="employee_id"/>
                <field name="reviewer_id"/>
                <field name="overall_score" widget="progressbar"/>
            </tree>
        </field>
    </record>

    <record id="view_work_feedback_form" model="ir.ui.view">
        <field name="name">work.feedback.form</field>
        <field name="model">work.feedback</field>
        <field name="arch" type="xml">
            <form string="Feedback">
                <sheet>
                    <group>
                        <group>
                            <field name="presentation_id"/>
                            <field name="employee_id"/>
                            <field name="reviewer_id"/>
                        </group>
                        <group>
                            <field name="overall_score" readonly="1"/>
                        </group>
                    </group>
                    <group string="Tiêu Chí Đánh Giá (1-5 Sao)">
                        <group>
                            <field name="score_technical" widget="priority"/>
                            <field name="score_understanding" widget="priority"/>
                        </group>
                        <group>
                            <field name="score_problem_solving" widget="priority"/>
                            <field name="score_communication" widget="priority"/>
                        </group>
                    </group>
                    <group string="Nhận Xét">
                        <field name="comments" nolabel="1" placeholder="Nhập nhận xét chi tiết..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_work_feedback" model="ir.actions.act_window">
        <field name="name">Phản Hồi &amp; Đánh Giá</field>
        <field name="res_model">work.feedback</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
